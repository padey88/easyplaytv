# Copy to .env and replace the password before starting the proxy.
EASYPLAY_HOST=127.0.0.1
EASYPLAY_PORT=8601
EASYPLAY_USER=easyplay
EASYPLAY_PASS=replace-with-a-long-random-password
EASYPLAY_VOD_LANG=en

# Optional: base URL used in generated M3U/Xtream links (no trailing slash).
# EASYPLAY_PUBLIC_URL=http://192.168.1.10:8601

# Catalogue build tuning
EASYPLAY_CATALOGUE_PAGES=30
EASYPLAY_CATALOGUE_WORKERS=6
